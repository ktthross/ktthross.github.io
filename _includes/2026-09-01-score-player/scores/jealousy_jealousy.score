# Olivia Rodrigo -- "jealousy, jealousy" (SOUR, 2021).
# Short excerpt, transcribed by ear, here to demonstrate the synthesis.
#
# The opposite stress case from the Debussy. Everything is short, dry and
# syncopated, so most notes are gone before their own fitting window has
# closed -- the reconstruction never gets to settle, and at a wide integration
# window you hear it guessing. Turn the note length down and it gets worse;
# that is the interesting direction.

tempo 164
meter 4

track riff
  repeat 2
    B2:s -:s B2:s -:s  B2:e D3   F#3:e -:e  A2:e -:e
    B2:s -:s B2:s -:s  B2:e C#3  D3:e -:e   F#2:e -:e
    G2:s -:s G2:s -:s  G2:e A2   D3:e -:e   F#3:e -:e
    F#2:s -:s F#2:s -:s  F#2:e A2  C#3:e -:e  E3:e -:e
  end

track hook gain 0.75
  -:w
  -:h  F#4:e E4  D4:e -:e
  -:h  D4:e C#4  B3:e -:e
  F#4:e E4 D4 C#4  B3:h
  -:w
  -:h  F#4:e E4  D4:e -:e
  -:h  B4:e A4   F#4:e -:e
  E4:e D4 C#4 B3  B3:h
